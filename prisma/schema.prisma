generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  authProvider String   @default("email")
  createdAt    DateTime @default(now())

  canvases     Canvas[]
  persons      Person[]
}

model Person {
  id          String   @id @default(uuid())
  name        String
  bornYear    Int
  bornPrecision String @default("year")
  diedYear    Int?
  diedPrecision String?
  bornCity    String?
  bornCountry String?
  type        String   @default("personal") // "famous" | "personal"
  wikidataId  String?  @unique
  isPublic    Boolean  @default(false)
  color       String   @default("#94A3B8")
  photoUrl    String?
  createdBy   String?
  createdAt   DateTime @default(now())

  creator     User?         @relation(fields: [createdBy], references: [id])
  events      LifeEvent[]
  canvases    CanvasPerson[]
}

model LifeEvent {
  id          String   @id @default(uuid())
  personId    String
  year        Int
  month       Int?
  title       String
  description String?
  locationName String?
  locationLat Float?
  locationLng Float?
  source      String   @default("user") // "wikidata" | "user"
  wikidataEventId String?
  createdAt   DateTime @default(now())

  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Canvas {
  id        String   @id @default(uuid())
  userId    String?
  name      String?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?          @relation(fields: [userId], references: [id])
  persons   CanvasPerson[]
}

model CanvasPerson {
  canvasId   String
  personId   String
  trackColor String
  position   Int
  addedAt    DateTime @default(now())

  canvas     Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([canvasId, personId])
}
